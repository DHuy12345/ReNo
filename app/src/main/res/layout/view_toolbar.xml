<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh "← Tiêu đề" của các màn mở sâu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_half"
    android:paddingEnd="@dimen/space_2">

    <ImageButton
        android:id="@+id/btn_back"
        style="@style/Widget.Reno.IconButton"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_half"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Reno.Title" />

    <TextView
        android:id="@+id/text_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Reno.Body"
        android:textColor="@color/text_secondary" />
</LinearLayout>
