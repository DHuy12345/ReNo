<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/space_half"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Reno.Section" />

            <TextView
                android:id="@+id/text_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Reno.Body" />

            <TextView
                android:id="@+id/text_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Reno.Body"
                android:textColor="@color/text_secondary"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/text_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:textAppearance="@style/TextAppearance.Reno.Caption" />

            <TextView
                android:id="@+id/text_jump"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:text="@string/annotation_jump"
                android:textAppearance="@style/TextAppearance.Reno.Caption"
                android:textColor="@color/moss" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/Widget.Reno.IconButton"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_2"
        android:background="@color/line" />
</LinearLayout>
