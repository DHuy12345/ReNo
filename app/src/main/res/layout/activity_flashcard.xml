<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <include
            android:id="@+id/flashcard"
            layout="@layout/view_flashcard" />

        <TextView
            android:id="@+id/text_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flashcard_empty"
            android:textAppearance="@style/TextAppearance.Reno.Body"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- Mũi tên trái / phải; tối đi ở hai đầu, không quay vòng -->
        <LinearLayout
            android:id="@+id/row_arrows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prev"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/flashcard_prev"
                app:icon="@drawable/ic_chevron_left"
                app:iconSize="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/space_4"
                android:contentDescription="@string/flashcard_next"
                app:icon="@drawable/ic_chevron_right"
                app:iconSize="28dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
