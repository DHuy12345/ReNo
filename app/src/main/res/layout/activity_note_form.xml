<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingBottom="@dimen/space_3">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_title"
                style="@style/Widget.Reno.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_name_hint"
                app:counterEnabled="true"
                app:counterMaxLength="200"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="200"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/note_start_date"
                        android:textAppearance="@style/TextAppearance.Reno.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_date"
                        style="@style/Widget.Reno.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_calendar"
                        app:iconSize="18dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/note_start_time"
                        android:textAppearance="@style/TextAppearance.Reno.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_time"
                        style="@style/Widget.Reno.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_clock"
                        app:iconSize="18dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_start_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:textAppearance="@style/TextAppearance.Reno.Caption"
                android:textColor="@color/error"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_duration"
                style="@style/Widget.Reno.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/note_duration_hint"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/note_color"
                android:textAppearance="@style/TextAppearance.Reno.Caption" />

            <com.reno.app.ui.common.ColorPaletteView
                android:id="@+id/palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/note_repeat"
                android:textAppearance="@style/TextAppearance.Reno.Section" />

            <RadioGroup
                android:id="@+id/group_repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/note_repeat_none"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_daily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/note_repeat_daily"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/note_repeat_interval"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/note_repeat_custom"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_interval"
                style="@style/Widget.Reno.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:hint="@string/note_interval_hint"
                android:visibility="gone"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Chỉ hiện với "Mỗi ngày" và "Cách n ngày" -->
            <LinearLayout
                android:id="@+id/section_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/note_repeat_until"
                    android:textAppearance="@style/TextAppearance.Reno.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_until"
                        style="@style/Widget.Reno.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/note_repeat_unlimited" />

                    <ImageButton
                        android:id="@+id/btn_until_clear"
                        style="@style/Widget.Reno.IconButton"
                        android:contentDescription="@string/note_repeat_until_clear"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_until_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_note_until"
                    android:textAppearance="@style/TextAppearance.Reno.Caption"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/note_exdates"
                    android:textAppearance="@style/TextAppearance.Reno.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_exdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Chỉ hiện với "Các ngày tự chọn" -->
            <LinearLayout
                android:id="@+id/section_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/note_rdates"
                    android:textAppearance="@style/TextAppearance.Reno.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_rdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@color/bg_alt"
                android:padding="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Reno.Caption"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/Widget.Reno.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_3"
        android:layout_marginVertical="@dimen/space_1"
        android:text="@string/save" />
</LinearLayout>
