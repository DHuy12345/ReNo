<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bảng chọn: Chụp ảnh hoặc Chọn ảnh từ thiết bị -->
    <LinearLayout
        android:id="@+id/section_choose"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_camera"
            app:tint="@color/moss" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginBottom="@dimen/space_3"
            android:gravity="center"
            android:text="@string/camera_intro"
            android:textAppearance="@style/TextAppearance.Reno.Body"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_take"
            style="@style/Widget.Reno.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_take"
            app:icon="@drawable/ic_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick"
            style="@style/Widget.Reno.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/camera_pick"
            app:icon="@drawable/ic_image" />
    </LinearLayout>

    <!-- Màn kết quả -->
    <LinearLayout
        android:id="@+id/section_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_thumb"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/thumb_height"
                        android:layout_weight="1"
                        android:background="@color/bg_alt"
                        android:contentDescription="@string/camera_thumbnail"
                        android:scaleType="centerCrop" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_other"
                        style="@style/Widget.Reno.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/camera_other" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_recognizing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/camera_recognizing"
                        android:textAppearance="@style/TextAppearance.Reno.Body" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Reno.Body"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/camera_result_hint"
                    android:textAppearance="@style/TextAppearance.Reno.Caption"
                    android:visibility="gone" />

                <!-- Văn bản nhận được, cho phép bôi đen -->
                <TextView
                    android:id="@+id/text_ocr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:lineSpacingMultiplier="1.3"
                    android:textAppearance="@style/TextAppearance.Reno.Body"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Khung dịch: "từ → nghĩa" và dấu "+" -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_translation"
            style="@style/Widget.Reno.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_2"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_translation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Reno.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_word"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:contentDescription="@string/camera_add_word"
                        android:visibility="gone"
                        app:icon="@drawable/ic_add" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry"
                        style="@style/Widget.Reno.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/retry"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_translation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_half"
                    android:text="@string/camera_translate_source"
                    android:textAppearance="@style/TextAppearance.Reno.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
